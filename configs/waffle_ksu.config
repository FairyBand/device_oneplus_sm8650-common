# KernelSU (BakaSU) + SUSFS configuration for waffle (OnePlus 12)
# Merged on top of gki_defconfig + vendor/pineapple_GKI.config +
# vendor/oplus/pineapple_GKI.config + vendor/oplus/waffle.config
#
# Kernel driver: BakaSU (https://github.com/Baka-SU/BakaSU) as a full git
# clone at kernel/oneplus/sm8650/KernelSU, symlinked to drivers/kernelsu.
# BakaSU is used instead of upstream tiann/KernelSU because it accepts
# multiple manager APKs (KernelSU Official, KOWSU, BakaSU), so the user can
# install whichever manager they prefer as a normal (non-system) app.
# The manager APK is intentionally NOT bundled in the build.

CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_DISABLE_POLICY=n

# Accept manager APKs signed by KernelSU Official / KOWSU / BakaSU.
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# Hooking method (Kconfig choice): SUSFS inline hook. This is also what
# installs the ksu_handle_* manual hooks the SUSFS kernel patch relies on.
# CONFIG_KSU_TRACEPOINT_HOOK and CONFIG_KSU_MANUAL_HOOK must stay unset.
CONFIG_KSU_SUSFS=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set

CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=n
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
